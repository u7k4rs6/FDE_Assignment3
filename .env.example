# Local mock service (run_local.py and the eval scripts start it on this port)
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider: Anthropic
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-5-5
# Optional tuning
# LLM_EFFORT=medium            # low | medium | high
# LLM_TIMEOUT_SECONDS=90
# COPILOT_DISABLE_LLM=0        # 1 = rules-only fallback (no LLM calls)
# PROCUREMENT_DATA_DIR=        # point the whole system at another data snapshot
